class Sensor:
    def __init__(self, id_sensor, lokasi, jenis):
        self.id_sensor = id_sensor
        self.lokasi = lokasi
        self.jenis = jenis
    
    def info(self):
        return f"ID: {self.id_sensor}, Lokasi: {self.lokasi}, Jenis: {self.jenis}"

class SensorSeismik(Sensor):
    def __init__(self, id_sensor, lokasi, jenis, frekuensi_sampling):
        super().__init__(id_sensor, lokasi, jenis)
        self.frekuensi_sampling = frekuensi_sampling
        self.data_amplitudo = []
    
    def jumlah_sampel(self):
        return len(self.data_amplitudo)

sensor = SensorSeismik("S001", "Bandung", "Seismometer", 100)

sensor.data_amplitudo.append(0.5)
sensor.data_amplitudo.append(1.2)
sensor.data_amplitudo.append(0.8)

print(sensor.info())
print(f"Jumlah Sampel: {sensor.jumlah_sampel()}")
print(f"Data Amplitudo: {sensor.data_amplitudo}")

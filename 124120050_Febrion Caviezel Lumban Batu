import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

data = pd.DataFrame({
    'X': [0, 0, 50, 50, 100, 100],
    'Y': [0, 50, 0, 50, 0, 50],
    'Z': [43210, 43280, 43100, 43420, 43050, 43500]
})

pivot = data.pivot_table(index='Y', columns='X', values='Z')
X, Y = np.meshgrid(pivot.columns, pivot.index)
Z = pivot.values

plt.figure(figsize=(6,5))
plt.contourf(X, Y, Z, cmap='coolwarm', levels=15)
plt.colorbar(label='Total Field (nT)')
plt.xlabel('X (m)')
plt.ylabel('Y (m)')
plt.title('Peta Anomali Medan Magnetik')
plt.show()
